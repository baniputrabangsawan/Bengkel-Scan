<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- start/stop bluetooth adapter -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>
    <!-- connect/disconnect bluetooth devices -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <!-- needed for BLE scan / connect -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- location only needed for BT/BLE scan on API 23-30; replaced by BLUETOOTH_SCAN on API 31+ -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- to keep Bluetooth measurement running even when screen is inactive -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- allow saving screenshots -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- allow access to WIFI adapter -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- post notifications (SDK 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- For foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required for foreground service of type connectedDevice (API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application
        android:allowBackup="true"
        android:description="@string/app_description"
        android:fullBackupContent="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:mimeType="application/octet-stream"
                    android:pathPattern=".*\\.obd"
                    android:scheme="content" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
        <activity
            android:name=".UsbDeviceListActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="@string/select_device" />
        <activity
            android:name=".BtDeviceListActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="@string/select_device"
            android:exported="true"/>
        <activity
            android:name=".BleDeviceListActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="@string/select_ble_device"
            android:exported="true"
            tools:targetApi="21" />
        <activity
            android:name=".ChartActivity"
            android:configChanges="touchscreen|orientation|screenSize"
            android:label="@string/chart" />
        <activity
            android:name=".DashBoardActivity"
            android:configChanges="touchscreen|orientation|screenSize"
            android:label="@string/dashboard" />
        <activity
            android:name=".SettingsActivity"
            android:configChanges="touchscreen|orientation|screenSize"
            android:label="@string/settings" />
        <activity
            android:name=".PidCustomization"
            android:label="@string/customize_display"
            android:configChanges="touchscreen|orientation|screenSize" />
        <activity
            android:name=".workshop.ui.WorkshopCustomersActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/workshop_customers_title" />
        <activity
            android:name=".workshop.ui.WorkshopCustomerActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/workshop_customers_title" />
        <activity
            android:name=".workshop.ui.WorkshopPdfActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/workshop_pdf_title" />
        <activity
            android:name=".workshop.ui.WorkshopDueActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/workshop_due_title" />
        <activity
            android:name=".workshop.ui.WorkshopCannedJobsActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/workshop_canned_title" />
        <activity
            android:name=".workshop.ui.WorkshopInspectionActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/workshop_inspection_title" />
        <activity
            android:name=".workshop.ui.WorkshopScanActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/workshop_scan_title" />
        <activity
            android:name=".workshop.ui.WorkshopScanCompareActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/workshop_scan_compare_title" />
        <activity
            android:name=".workshop.ui.WorkshopJobsActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/workshop_jobs_title" />
        <activity
            android:name=".workshop.ui.WorkshopProfileActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/workshop_profile_title" />
        <activity
            android:name=".workshop.ui.WorkshopVehicleActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/workshop_vehicles_title" />
        <activity
            android:name=".workshop.ui.WorkshopServiceActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/workshop_services_title" />
        <activity
            android:name=".diagnosis.ui.SoundGuideActivity"
            android:exported="false"
            android:label="@string/diagnosis_sound_title" />
        <activity
            android:name=".diagnosis.ui.DiagnosisCaseActivity"
            android:exported="false"
            android:label="@string/diagnosis_case_title"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".diagnosis.ui.DiagnosisStartActivity"
            android:exported="false"
            android:label="@string/diagnosis_start_title" />
        <activity
            android:name=".diagnosis.ui.DiagnosisQuestionsActivity"
            android:exported="false"
            android:label="@string/diagnosis_questions_title" />
        <activity
            android:name=".diagnosis.ui.DiagnosisResultsActivity"
            android:exported="false"
            android:label="@string/diagnosis_results_title" />
        <activity
            android:name=".workshop.ui.WorkshopDiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostic_title" />
        <activity
            android:name=".workshop.ui.WorkshopDiagnosticEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/diagnostic_title" />
        <activity
            android:name=".workshop.ui.WorkshopGuideActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/diagnostic_guides" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths"/>
        </provider>
    </application>

</manifest>