<?xml version="1.0" encoding="utf-8"?>
<!--
  Text-field background with a real focus ring. The previous row drawable only carried
  state_activated, so a focused input looked identical to an idle one.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/workshop_surface_variant" />
            <stroke android:width="@dimen/ui_card_stroke" android:color="@color/workshop_divider" />
            <corners android:radius="@dimen/ui_card_corner" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/workshop_surface" />
            <stroke android:width="2dp" android:color="@color/workshop_primary" />
            <corners android:radius="@dimen/ui_card_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/workshop_surface" />
            <stroke android:width="@dimen/ui_card_stroke" android:color="@color/workshop_outline" />
            <corners android:radius="@dimen/ui_card_corner" />
        </shape>
    </item>
</selector>
