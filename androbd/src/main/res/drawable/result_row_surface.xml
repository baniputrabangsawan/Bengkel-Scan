<?xml version="1.0" encoding="utf-8"?>
<!--
  Card surface: flat, 12 dp corners, 1 dp border. Also the background of an interactive
  row, hence the ripple and the activated state.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/workshop_ripple">
    <item>
        <selector>
            <item android:state_activated="true" android:state_pressed="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/workshop_selected_surface" />
                    <stroke android:width="@dimen/ui_card_stroke" android:color="@color/workshop_outline" />
                    <corners android:radius="@dimen/ui_card_corner" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/workshop_surface" />
                    <stroke android:width="@dimen/ui_card_stroke" android:color="@color/workshop_outline" />
                    <corners android:radius="@dimen/ui_card_corner" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
