<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      API 28+ can make a whole card one accessibility stop; older versions keep the default,
      where TalkBack reads the children instead. Parent stays WorkshopHomePanel so the
      values/ definition is inherited, not replaced.
    -->
    <style name="WorkshopHomeTile" parent="WorkshopHomePanel">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">@dimen/ui_touch_primary</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:screenReaderFocusable">true</item>
    </style>
</resources>
