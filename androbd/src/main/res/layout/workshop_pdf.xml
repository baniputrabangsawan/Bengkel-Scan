<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/workshop_page_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_screen_padding_horizontal"
        android:paddingTop="@dimen/ui_screen_padding_top"
        android:paddingEnd="@dimen/ui_screen_padding_horizontal"
        android:paddingBottom="@dimen/ui_screen_padding_bottom">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workshop_pdf_intro"
            android:textAppearance="@style/WorkshopHomeHelper" />

        <TextView
            android:id="@+id/workshop_pdf_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/WorkshopHomeHelper" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/workshop_pdf_report"
            style="@style/UiButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="@dimen/ui_touch_primary"
            android:text="@string/workshop_pdf_report" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/workshop_pdf_invoice"
            style="@style/UiButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_2"
            android:minHeight="@dimen/ui_touch_primary"
            android:text="@string/workshop_pdf_invoice" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/workshop_pdf_share"
            style="@style/UiButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_6"
            android:minHeight="@dimen/ui_touch_primary"
            android:text="@string/workshop_pdf_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/workshop_pdf_share_text"
            style="@style/UiButton.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_2"
            android:minHeight="@dimen/ui_touch_primary"
            android:text="@string/workshop_pdf_share_text" />
    </LinearLayout>
</ScrollView>
