<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/UiScreen"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <EditText
        android:id="@+id/workshop_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:background="@drawable/result_row_surface"
        android:hint="@string/workshop_customers_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:minHeight="@dimen/ui_touch_primary"
        android:paddingStart="@dimen/ui_screen_padding_horizontal"
        android:paddingEnd="@dimen/ui_screen_padding_horizontal"
        android:singleLine="true"
        android:textColor="@color/workshop_on_surface"
        android:textColorHint="@color/workshop_secondary_text"
        android:textAppearance="@style/UiText.Body" />

    <TextView
        android:id="@+id/workshop_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_6"
        android:gravity="center"
        android:text="@string/workshop_customers_empty"
        android:textAppearance="@style/WorkshopHomeHelper"
        android:visibility="gone" />

    <ListView
        android:id="@+id/workshop_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ui_space_3"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/workshop_add"
            style="@style/WorkshopHomePrimaryAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/workshop_customers_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/workshop_backup"
            style="@style/WorkshopHomeSecondaryAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/workshop_backup" />
    </LinearLayout>
</LinearLayout>