<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    android:id="@+id/obd_list"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <TextView
        android:id="@+id/mil_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@color/workshop_warning_surface"
        android:textColor="@color/workshop_warning_text"
        android:textSize="@dimen/workshop_label_size"
        android:text="@string/mil_warning"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <TextView
        android:id="@+id/diagnosis_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/ff_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:prompt="@string/select_fault_code"
        android:spinnerMode="dialog"
        android:visibility="visible"
        android:contentDescription="@string/select_fault_code"
        android:minHeight="48dp" />

    <ListView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:layout_gravity="center_horizontal"
        android:choiceMode="multipleChoice"
        android:dividerHeight="1dp"
        android:fastScrollEnabled="true"
        android:scrollbarStyle="outsideOverlay"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

</LinearLayout>
