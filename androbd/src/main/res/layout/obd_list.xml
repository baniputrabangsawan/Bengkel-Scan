<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    android:id="@+id/obd_list"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/UiScreen">

    <TextView
        android:id="@+id/mil_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:padding="@dimen/ui_space_3"
        android:background="@color/workshop_warning_surface"
        android:textColor="@color/workshop_warning_text"
        android:textAppearance="@style/UiText.Body"
        android:text="@string/mil_warning"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <TextView
        android:id="@+id/diagnosis_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_3"
        android:layout_marginBottom="@dimen/ui_space_1"
        android:textColor="@color/workshop_secondary_text"
        android:textAppearance="@style/UiText.Meta"
        android:lineSpacingMultiplier="1.2"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/ff_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_2"
        android:layout_marginBottom="@dimen/ui_space_1"
        android:prompt="@string/select_fault_code"
        android:spinnerMode="dialog"
        android:visibility="visible"
        android:contentDescription="@string/select_fault_code"
        android:minHeight="@dimen/ui_touch_min" />

    <ListView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center_horizontal"
        android:choiceMode="multipleChoice"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/ui_space_2"
        android:clipToPadding="false"
        android:paddingTop="@dimen/ui_space_3"
        android:paddingBottom="@dimen/ui_space_4" />

</LinearLayout>
