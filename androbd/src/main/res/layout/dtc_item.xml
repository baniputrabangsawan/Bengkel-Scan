<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/ui_card_padding"
    android:background="@drawable/result_row_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/obd_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            app:tint="@color/workshop_primary"
            android:src="@drawable/ic_code" />

        <TextView
            android:id="@+id/obd_units"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textAppearance="@style/UiText.Title"
            android:textStyle="bold"
            android:textDirection="ltr"
            android:textColor="@color/workshop_on_surface" />
    </LinearLayout>

    <TextView
        android:id="@+id/result_status"
        style="@style/UiChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_2" />

    <TextView
        android:id="@+id/obd_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_2"
        android:textColor="@color/workshop_on_surface"
        android:textAppearance="@style/UiText.Body"
        android:lineSpacingMultiplier="1.2" />

    <TextView
        android:id="@+id/result_context"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_2"
        android:text="@string/result_no_codes_scope"
        android:textColor="@color/workshop_secondary_text"
        android:textAppearance="@style/UiText.Meta"
        android:lineSpacingMultiplier="1.2"
        android:visibility="gone" />
</LinearLayout>
