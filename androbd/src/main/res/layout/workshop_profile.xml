<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/workshop_page_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_screen_padding_horizontal"
        android:paddingTop="@dimen/ui_screen_padding_top"
        android:paddingEnd="@dimen/ui_screen_padding_horizontal"
        android:paddingBottom="@dimen/ui_screen_padding_bottom">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workshop_profile_intro"
            android:textAppearance="@style/WorkshopHomeHelper" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/workshop_profile_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/workshop_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:minHeight="@dimen/ui_touch_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_3"
            android:hint="@string/workshop_profile_address">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/workshop_profile_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="3"
                android:minHeight="@dimen/ui_touch_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_3"
            android:hint="@string/workshop_profile_phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/workshop_profile_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:maxLines="1"
                android:minHeight="@dimen/ui_touch_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_3"
            android:hint="@string/workshop_profile_footer"
            app:helperText="@string/workshop_profile_footer_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/workshop_profile_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="3"
                android:minHeight="@dimen/ui_touch_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/workshop_profile_logo"
            style="@style/UiButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="@dimen/ui_touch_primary"
            android:text="@string/workshop_profile_logo_pick" />

        <TextView
            android:id="@+id/workshop_profile_logo_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_2"
            android:text="@string/workshop_profile_logo_missing"
            android:textAppearance="@style/WorkshopHomeHelper" />

        <Button
            android:id="@+id/workshop_profile_save"
            style="@style/UiButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_6"
            android:minHeight="@dimen/ui_touch_primary"
            android:text="@string/workshop_profile_save" />
    </LinearLayout>
</ScrollView>
