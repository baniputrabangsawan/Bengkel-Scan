<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/workshop_page_background"
    android:fillViewport="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/home_heading"
            android:textAppearance="@style/WorkshopHomeHeading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_subheading"
            android:textAppearance="@style/WorkshopHomeHelper" />

        <com.google.android.material.card.MaterialCardView
            style="@style/WorkshopHomePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_connection_label"
                    android:textAppearance="@style/WorkshopHomeHelper" />

                <TextView
                    android:id="@+id/home_connection_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/home_status_offline"
                    android:textAppearance="@style/WorkshopHomeSectionHeading" />

                <TextView
                    android:id="@+id/home_connection_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_offline_detail"
                    android:textAppearance="@style/WorkshopHomeHelper" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_connection_action"
                    style="@style/WorkshopHomePrimaryAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:onClick="onWorkshopHomeClick"
                    android:text="@string/action_connect" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:accessibilityHeading="true"
            android:text="@string/home_checks_heading"
            android:textAppearance="@style/WorkshopHomeSectionHeading" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_faults"
                style="@style/WorkshopHomeTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:onClick="onWorkshopHomeClick">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_code"
                        app:tint="@color/workshop_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/obd_codes"
                        android:textAppearance="@style/WorkshopHomeTileTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/home_faults_hint"
                        android:textAppearance="@style/WorkshopHomeHelper" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_live"
                style="@style/WorkshopHomeTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:onClick="onWorkshopHomeClick">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_visibility"
                        app:tint="@color/workshop_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/obd_data"
                        android:textAppearance="@style/WorkshopHomeTileTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/home_live_hint"
                        android:textAppearance="@style/WorkshopHomeHelper" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_freeze"
                style="@style/WorkshopHomeTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:onClick="onWorkshopHomeClick">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_history"
                        app:tint="@color/workshop_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/service_freezeframes"
                        android:textAppearance="@style/WorkshopHomeTileTitle" />

                    <TextView
                        android:id="@+id/home_freeze_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/home_freeze_unavailable_hint"
                        android:textAppearance="@style/WorkshopHomeHelper" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_vehicle"
                style="@style/WorkshopHomeTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:onClick="onWorkshopHomeClick">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_info"
                        app:tint="@color/workshop_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/obd_veh_info"
                        android:textAppearance="@style/WorkshopHomeTileTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/home_vehicle_hint"
                        android:textAppearance="@style/WorkshopHomeHelper" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_workshop"
            style="@style/WorkshopHomeTile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:enabled="true"
            android:onClick="onWorkshopHomeClick">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_workshop_people"
                    app:tint="@color/workshop_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityHeading="true"
                    android:text="@string/workshop_data_title"
                    android:textAppearance="@style/WorkshopHomeSectionHeading" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_workshop_title"
                    android:textAppearance="@style/WorkshopHomeTileTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/home_workshop_hint"
                    android:textAppearance="@style/WorkshopHomeHelper" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/home_workshop_action"
                    android:textColor="@color/workshop_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_guided_diagnosis"
            style="@style/WorkshopHomeSecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:onClick="onWorkshopHomeClick"
            android:text="@string/diagnosis_start_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_guides"
            style="@style/WorkshopHomeSecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:onClick="onWorkshopHomeClick"
            android:text="@string/diagnostic_guides" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_settings"
            style="@style/WorkshopHomeSecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:onClick="onWorkshopHomeClick"
            android:text="@string/home_settings_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/home_attribution"
            android:textAppearance="@style/WorkshopHomeHelper" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_about"
            style="@style/WorkshopHomeTextAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onWorkshopHomeClick"
            android:text="@string/home_about_label" />

        <ListView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:importantForAccessibility="noHideDescendants"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
