<?xml version="1.0" encoding="utf-8"?>
<!--
  One workshop list row: title, optional meta line, optional status chip.

  The whole row is a single accessibility stop (screenReaderFocusable on API 28+, where the
  platform can merge children) and always at least 64 dp tall, so it stays tappable with
  gloves on. The status chip carries a label, never colour alone.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ui_space_1"
    android:layout_marginBottom="@dimen/ui_space_1"
    android:background="@drawable/result_row_surface"
    android:gravity="center_vertical"
    android:minHeight="@dimen/ui_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ui_card_padding"
    android:paddingTop="@dimen/ui_space_3"
    android:paddingEnd="@dimen/ui_card_padding"
    android:paddingBottom="@dimen/ui_space_3">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/workshop_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/UiText.Item"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/workshop_row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_1"
            android:textAppearance="@style/UiText.Meta" />
    </LinearLayout>

    <!-- Status text used where the row already reads as a sentence (estimate lines). -->
    <TextView
        android:id="@+id/workshop_row_trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_space_3"
        android:gravity="end"
        android:maxLines="2"
        android:textAppearance="@style/UiText.Meta"
        android:textColor="@color/workshop_on_surface"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Status chip used where the row state is a workflow or safety decision. -->
    <TextView
        android:id="@+id/workshop_row_chip"
        style="@style/UiChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_space_3"
        android:visibility="gone" />
</LinearLayout>
