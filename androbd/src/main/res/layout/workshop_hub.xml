<?xml version="1.0" encoding="utf-8"?>
<!--
  "Data bengkel" hub: the actions that used to live in an overflow menu nobody opened.
  Each entry is one tappable card, at least 56 dp, with its own label and a one-line hint.
  Restore and CSV stay here; nothing is removed from the app.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/UiScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workshop_hub_intro"
            android:textAppearance="@style/UiText.Body" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hub_profile"
            style="@style/UiCard.Tappable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_touch_primary"
                android:orientation="vertical"
                android:padding="@dimen/ui_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/workshop_profile_title"
                    android:textAppearance="@style/UiText.Item" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_space_1"
                    android:text="@string/workshop_hub_profile_hint"
                    android:textAppearance="@style/UiText.Meta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hub_due"
            style="@style/UiCard.Tappable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_touch_primary"
                android:orientation="vertical"
                android:padding="@dimen/ui_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/workshop_due_title"
                    android:textAppearance="@style/UiText.Item" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_space_1"
                    android:text="@string/workshop_hub_due_hint"
                    android:textAppearance="@style/UiText.Meta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hub_canned"
            style="@style/UiCard.Tappable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_touch_primary"
                android:orientation="vertical"
                android:padding="@dimen/ui_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/workshop_canned_title"
                    android:textAppearance="@style/UiText.Item" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_space_1"
                    android:text="@string/workshop_hub_canned_hint"
                    android:textAppearance="@style/UiText.Meta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_6"
            android:accessibilityHeading="true"
            android:text="@string/workshop_hub_data_heading"
            android:textAppearance="@style/UiText.Section" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hub_export"
            style="@style/UiButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_3"
            android:text="@string/workshop_export_csv" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hub_backup"
            style="@style/UiButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_3"
            android:text="@string/workshop_backup" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hub_restore"
            style="@style/UiButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_3"
            android:text="@string/workshop_restore_menu" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_3"
            android:text="@string/workshop_hub_restore_hint"
            android:textAppearance="@style/UiText.Meta" />
    </LinearLayout>
</ScrollView>
