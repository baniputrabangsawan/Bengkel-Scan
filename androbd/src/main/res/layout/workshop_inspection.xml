<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/UiScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/workshop_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/workshop_inspection_empty"
        android:textAppearance="@style/WorkshopHomeHelper"
        android:visibility="gone" />

    <ListView
        android:id="@+id/workshop_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/workshop_add"
        style="@style/WorkshopHomePrimaryAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_2"
        android:text="@string/workshop_inspection_add" />
</LinearLayout>
