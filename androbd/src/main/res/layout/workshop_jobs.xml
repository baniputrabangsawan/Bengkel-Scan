<?xml version="1.0" encoding="utf-8"?>
<!--
  Job list with a filter row. The active filter is a filled button (never a disabled one)
  and the row scrolls horizontally only if the labels genuinely do not fit.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/UiScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/ui_space_3">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/workshop_jobs_all"
                style="@style/UiButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workshop_jobs_filter_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/workshop_jobs_open"
                style="@style/UiButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_space_2"
                android:text="@string/workshop_jobs_filter_open" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/workshop_jobs_today"
                style="@style/UiButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_space_2"
                android:text="@string/workshop_jobs_filter_today" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/workshop_jobs_unpaid"
                style="@style/UiButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_space_2"
                android:text="@string/workshop_jobs_filter_unpaid" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/workshop_empty"
        style="@style/UiStateMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_6"
        android:text="@string/workshop_jobs_empty"
        android:visibility="gone" />

    <ListView
        android:id="@+id/workshop_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ui_space_2"
        android:layout_weight="1"
        android:divider="@null"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/ui_space_2" />
</LinearLayout>
