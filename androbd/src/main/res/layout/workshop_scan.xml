<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/workshop_page_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_screen_padding_horizontal"
        android:paddingTop="@dimen/ui_screen_padding_top"
        android:paddingEnd="@dimen/ui_screen_padding_horizontal"
        android:paddingBottom="@dimen/ui_screen_padding_bottom">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workshop_scan_intro"
            android:textAppearance="@style/WorkshopHomeHelper" />

        <TextView
            android:id="@+id/workshop_scan_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/workshop_scan_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_2"
            android:textAppearance="@style/WorkshopHomeHelper" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/workshop_scan_phase"
            android:textColor="@color/workshop_secondary_text"
            android:textAppearance="@style/UiText.Meta" />

        <RadioGroup
            android:id="@+id/workshop_scan_phase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_2"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/workshop_scan_before"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:checked="true"
                android:text="@string/workshop_scan_phase_before" />

            <RadioButton
                android:id="@+id/workshop_scan_after"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/workshop_scan_phase_after" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/workshop_scan_note">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/workshop_scan_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="3"
                android:minHeight="@dimen/ui_touch_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/workshop_scan_save"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_6"
            android:minHeight="@dimen/ui_touch_primary"
            android:text="@string/workshop_scan_save" />
    </LinearLayout>
</ScrollView>
