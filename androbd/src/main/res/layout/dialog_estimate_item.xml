<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/workshop_item_kind"
        android:textColor="@color/workshop_secondary_text"
        android:textAppearance="@style/UiText.Meta" />

    <Spinner
        android:id="@+id/workshop_kind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_1"
        android:background="@drawable/result_row_surface"
        android:minHeight="@dimen/ui_touch_primary"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/UiField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_3"
        android:hint="@string/workshop_item_description">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/workshop_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/UiField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_3"
        android:hint="@string/workshop_item_quantity">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/workshop_quantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:text="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/UiField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_3"
        android:hint="@string/workshop_item_unit_price">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/workshop_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/UiField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_3"
        android:hint="@string/workshop_item_discount"
        app:helperText="@string/workshop_item_discount_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/workshop_discount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/workshop_item_inspection_link"
        android:textColor="@color/workshop_secondary_text"
        android:textAppearance="@style/UiText.Meta" />

    <Spinner
        android:id="@+id/workshop_inspection_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_space_1"
        android:background="@drawable/result_row_surface"
        android:minHeight="@dimen/ui_touch_primary"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

</LinearLayout>