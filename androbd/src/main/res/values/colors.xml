<?xml version="1.0" encoding="utf-8"?>
<!--
  Warna aplikasi. Nilai dasar (halaman, kartu, teks, aksen, garis, peringatan, ikon)
  dikembalikan persis seperti sebelum perbaikan tampilan. Token status tetap ada karena
  kode memakainya, tetapi warnanya diambil dari palet lama: tidak ada hue baru.
-->
<resources>
    <!-- Warna dasar: nilai asli -->
    <color name="row_activated">#D9EDF2</color>
    <color name="workshop_primary">#164E63</color>
    <color name="workshop_on_primary">#FFFFFF</color>
    <color name="workshop_surface">#FFFFFF</color>
    <color name="workshop_on_surface">#111827</color>
    <color name="workshop_secondary_text">#374151</color>
    <color name="workshop_surface_variant">#EDF2F4</color>
    <color name="workshop_outline">#64748B</color>
    <color name="workshop_border">#DAE2E8</color>
    <color name="workshop_page_background">#F5F7FA</color>
    <color name="workshop_warning_surface">#FEE2E2</color>
    <color name="workshop_warning_text">#7F1D1D</color>
    <color name="workshop_icon_background">#164E63</color>
    <color name="workshop_icon_foreground">#FFFFFF</color>

    <!--
      Token tambahan yang tidak ada sebelum perbaikan tampilan. Nilainya diturunkan dari
      palet lama di atas, supaya layar tidak memunculkan warna yang tidak pernah dipakai.
    -->
    <color name="workshop_selected_surface">#D9EDF2</color>
    <color name="workshop_divider">#DAE2E8</color>
    <color name="workshop_ripple">#33164E63</color>

    <!-- Status: hanya dua rupa seperti dulu, dibedakan oleh label teksnya -->
    <color name="workshop_status_neutral_surface">#EDF2F4</color>
    <color name="workshop_status_neutral_text">#111827</color>
    <color name="workshop_status_info_surface">#EDF2F4</color>
    <color name="workshop_status_info_text">#164E63</color>
    <color name="workshop_status_success_surface">#EDF2F4</color>
    <color name="workshop_status_success_text">#164E63</color>
    <color name="workshop_status_warning_surface">#FEE2E2</color>
    <color name="workshop_status_warning_text">#7F1D1D</color>
    <color name="workshop_status_danger_surface">#FEE2E2</color>
    <color name="workshop_status_danger_text">#7F1D1D</color>
</resources>
