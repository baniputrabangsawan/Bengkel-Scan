<?xml version="1.0" encoding="utf-8"?>
<!--
  Design tokens, light theme (default). Night overrides live in values-night/colors.xml.
  Every text pair below was measured against the surface it renders on; see
  docs/UI-REDESIGN.md for the ratio table. Do not add a colour here without measuring.
-->
<resources>
    <!-- Surfaces -->
    <color name="workshop_page_background">#F4F6F8</color>
    <color name="workshop_surface">#FFFFFF</color>
    <color name="workshop_surface_variant">#E8EEF1</color>
    <color name="workshop_selected_surface">#D6EAF2</color>

    <!-- Text -->
    <color name="workshop_on_surface">#10151A</color>
    <color name="workshop_secondary_text">#3F4B54</color>

    <!-- Action -->
    <color name="workshop_primary">#0B4A63</color>
    <color name="workshop_on_primary">#FFFFFF</color>

    <!-- Lines: 3:1 against both page and surface, so a boundary is visible in sunlight -->
    <color name="workshop_outline">#5A6B75</color>
    <color name="workshop_divider">#C7D0D6</color>

    <!-- Interaction -->
    <color name="workshop_ripple">#260B4A63</color>
    <color name="row_activated">#D6EAF2</color>

    <!-- Status families: chip surface + label. Each pair is measured. -->
    <color name="workshop_status_neutral_surface">#E5E9EC</color>
    <color name="workshop_status_neutral_text">#1F2937</color>
    <color name="workshop_status_info_surface">#D6EAF2</color>
    <color name="workshop_status_info_text">#0B4A63</color>
    <color name="workshop_status_success_surface">#DCFCE7</color>
    <color name="workshop_status_success_text">#14532D</color>
    <color name="workshop_status_warning_surface">#FEF3C7</color>
    <color name="workshop_status_warning_text">#8A4B08</color>
    <color name="workshop_status_danger_surface">#FEE2E2</color>
    <color name="workshop_status_danger_text">#991B1B</color>

    <!-- Safety banner: red on red, kept for the check-engine and SRS/transmission notices -->
    <color name="workshop_warning_surface">#FEE2E2</color>
    <color name="workshop_warning_text">#991B1B</color>

    <!-- Branding (launcher and logo) -->
    <color name="workshop_icon_background">#0B4A63</color>
    <color name="workshop_icon_foreground">#FFFFFF</color>
</resources>
