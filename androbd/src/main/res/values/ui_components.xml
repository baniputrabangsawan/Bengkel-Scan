<?xml version="1.0" encoding="utf-8"?>
<!--
  Reusable component styles. One definition per component; layouts reference the style and
  must not restate its attributes. Colours, sizes and radii come from the tokens in
  colors.xml / dimens.xml / type.xml.
-->
<resources>

    <!-- ============================ Buttons ============================ -->

    <!-- The one primary action of a screen: 56 dp, filled, no all-caps. -->
    <style name="UiButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/ui_touch_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">@dimen/ui_space_4</item>
        <item name="android:paddingEnd">@dimen/ui_space_4</item>
        <item name="android:paddingTop">@dimen/ui_space_3</item>
        <item name="android:paddingBottom">@dimen/ui_space_3</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/ui_card_corner</item>
        <item name="backgroundTint">@color/workshop_primary</item>
        <item name="android:textColor">@color/workshop_on_primary</item>
    </style>

    <style name="UiButton.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/ui_touch_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">@dimen/ui_space_4</item>
        <item name="android:paddingEnd">@dimen/ui_space_4</item>
        <item name="android:paddingTop">@dimen/ui_space_3</item>
        <item name="android:paddingBottom">@dimen/ui_space_3</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/ui_card_corner</item>
        <item name="strokeColor">@color/workshop_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/workshop_primary</item>
    </style>

    <!-- Tertiary action, e.g. "Save notes": 48 dp is enough, the label stays 16 sp. -->
    <style name="UiButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/ui_touch_min</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">3</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/workshop_primary</item>
        <item name="cornerRadius">@dimen/ui_card_corner</item>
    </style>

    <!-- Destructive action: deleting a line, discarding unsaved work. -->
    <style name="UiButton.Danger" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/ui_touch_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">3</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/ui_card_corner</item>
        <item name="backgroundTint">@color/workshop_status_danger_text</item>
        <item name="android:textColor">@color/workshop_status_danger_surface</item>
    </style>

    <!-- ============================ Surfaces ============================ -->

    <style name="UiCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/workshop_surface</item>
        <item name="cardCornerRadius">@dimen/ui_card_corner</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="strokeColor">@color/workshop_outline</item>
        <item name="strokeWidth">@dimen/ui_card_stroke</item>
    </style>

    <!-- A whole card that is one tap target and one TalkBack stop. -->
    <style name="UiCard.Tappable" parent="UiCard">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- ============================ Text fields ============================ -->

    <style name="UiField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/ui_card_corner</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ui_card_corner</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ui_card_corner</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ui_card_corner</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">@color/workshop_outline</item>
        <item name="hintTextColor">@color/workshop_secondary_text</item>
        <item name="android:textColorHint">@color/workshop_secondary_text</item>
        <item name="helperTextTextColor">@color/workshop_secondary_text</item>
        <item name="errorTextColor">@color/workshop_status_danger_text</item>
        <item name="android:layout_marginTop">@dimen/ui_field_gap</item>
    </style>

    <style name="UiField.Multiline" parent="UiField">
        <item name="android:minHeight">120dp</item>
    </style>

    <!-- ============================ Status chips ============================ -->

    <style name="UiChip">
        <item name="android:paddingStart">@dimen/ui_chip_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/ui_chip_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/ui_chip_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/ui_chip_padding_vertical</item>
        <item name="android:textAppearance">@style/UiText.Chip</item>
        <item name="android:maxLines">2</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/ui_chip_neutral</item>
        <item name="android:textColor">@color/workshop_status_neutral_text</item>
    </style>

    <style name="UiChip.Info">
        <item name="android:background">@drawable/ui_chip_info</item>
        <item name="android:textColor">@color/workshop_status_info_text</item>
    </style>

    <style name="UiChip.Success">
        <item name="android:background">@drawable/ui_chip_success</item>
        <item name="android:textColor">@color/workshop_status_success_text</item>
    </style>

    <style name="UiChip.Warning">
        <item name="android:background">@drawable/ui_chip_warning</item>
        <item name="android:textColor">@color/workshop_status_warning_text</item>
    </style>

    <style name="UiChip.Danger">
        <item name="android:background">@drawable/ui_chip_danger</item>
        <item name="android:textColor">@color/workshop_status_danger_text</item>
    </style>

    <!-- ============================ Dialogs ============================ -->

    <style name="UiDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/workshop_primary</item>
        <item name="colorSurface">@color/workshop_surface</item>
        <item name="colorOnSurface">@color/workshop_on_surface</item>
        <item name="android:textColorPrimary">@color/workshop_on_surface</item>
        <item name="android:textColorSecondary">@color/workshop_secondary_text</item>
        <item name="shapeAppearanceOverlay">@style/UiDialogShape</item>
    </style>

    <style name="UiDialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/ui_card_corner_large</item>
    </style>

    <!-- ============================ Screen scaffold ============================ -->

    <!-- Applied to the scrolling root of every screen: one padding rule, one page colour. -->
    <style name="UiScreen">
        <item name="android:background">@color/workshop_page_background</item>
        <item name="android:paddingStart">@dimen/ui_screen_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/ui_screen_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/ui_screen_padding_top</item>
        <item name="android:paddingBottom">@dimen/ui_screen_padding_bottom</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <!-- Gap between two cards or sections. -->
    <style name="UiSection">
        <item name="android:layout_marginTop">@dimen/ui_section_gap</item>
    </style>

    <!-- Empty / loading / error message block. -->
    <style name="UiStateMessage">
        <item name="android:textAppearance">@style/UiText.Body</item>
        <item name="android:textColor">@color/workshop_secondary_text</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">@dimen/ui_space_6</item>
        <item name="android:paddingBottom">@dimen/ui_space_6</item>
        <item name="android:paddingStart">@dimen/ui_space_4</item>
        <item name="android:paddingEnd">@dimen/ui_space_4</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>
</resources>
