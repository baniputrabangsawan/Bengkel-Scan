<resources>
    <!-- Application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight" >
        <item name="android:windowLightStatusBar">@bool/workshop_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/workshop_light_system_bars</item>
        <item name="android:activatedBackgroundIndicator">@drawable/activated_background</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="colorPrimary">@color/workshop_primary</item>
        <item name="colorOnPrimary">@color/workshop_on_primary</item>
        <item name="colorSecondary">@color/workshop_primary</item>
        <item name="colorOnSecondary">@color/workshop_on_primary</item>
        <item name="colorPrimaryContainer">@color/workshop_surface_variant</item>
        <item name="colorOnPrimaryContainer">@color/workshop_on_surface</item>
        <item name="colorSurface">@color/workshop_surface</item>
        <item name="colorOnSurface">@color/workshop_on_surface</item>
        <item name="colorSurfaceVariant">@color/workshop_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/workshop_secondary_text</item>
        <item name="colorOutline">@color/workshop_outline</item>
        <item name="colorControlNormal">@color/workshop_on_surface</item>
        <item name="android:colorBackground">@color/workshop_surface</item>
        <item name="android:textColorPrimary">@color/workshop_on_surface</item>
        <item name="android:textColorSecondary">@color/workshop_secondary_text</item>
        <item name="listPreferredItemHeightSmall">@dimen/workshop_touch_target</item>
        <item name="android:listPreferredItemHeightSmall">@dimen/workshop_touch_target</item>
        <item name="actionBarStyle">@style/WorkshopActionBar</item>
        <item name="colorControlActivated">@color/workshop_primary</item>
    </style>
    <style name="WorkshopActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/workshop_surface_variant</item>
    </style>
</resources>
