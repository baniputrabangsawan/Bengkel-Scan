<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Home-shell styles. These are aliases of the shared components in ui_components.xml so
      the home page, the workshop screens and the dialogs cannot drift apart: changing
      UiCard or UiButton changes every screen at once.
    -->
    <style name="WorkshopHomePanel" parent="UiCard" />

    <style name="WorkshopHomeTile" parent="WorkshopHomePanel">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">@dimen/ui_touch_primary</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="WorkshopHomeHeading" parent="UiText.Title" />

    <style name="WorkshopHomeSectionHeading" parent="UiText.Section" />

    <style name="WorkshopHomeTileTitle" parent="UiText.Item" />

    <style name="WorkshopHomeHelper" parent="UiText.Meta" />

    <style name="WorkshopHomePrimaryAction" parent="UiButton" />

    <style name="WorkshopHomeSecondaryAction" parent="UiButton.Secondary" />

    <style name="WorkshopHomeTextAction" parent="UiButton.Text" />
</resources>
